{
  "name": "sri-lanka-blood-connect-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fictional multi-hospital voluntary blood donor coordination research prototype.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply blood-connect-research --local",
    "db:seed:local": "wrangler d1 execute blood-connect-research --local --file=./seed/demo.sql",
    "db:migrate:remote": "wrangler d1 migrations apply blood-connect-research --remote",
    "db:seed:remote": "wrangler d1 execute blood-connect-research --remote --file=./seed/demo.sql",
    "check": "node --test tests/*.test.js"
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
